{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StreamViv",
  "mainBinaryName": "streamviv",
  "version": "2.1.2",
  "identifier": "com.devwolf75.streamviv",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "StreamViv",
        "label": "main",
        "width": 1280,
        "height": 720,
        "minWidth": 320,
        "minHeight": 240,
        "maximized": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "theme": "Dark",
        "backgroundColor": "#000000",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "silent": true,
        "type": "offlineInstaller"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true,
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good"
        ],
        "section": "video"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "gstreamer1-plugins-good"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "category": "Video",
    "shortDescription": "Lightweight capture card viewer",
    "longDescription": "StreamViv is a fast, lightweight viewer for USB capture cards with flexible resolution, frame-rate, rotation and fullscreen controls."
  }
}
