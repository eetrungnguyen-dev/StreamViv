<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Only consulted when the bundle is code-signed (hardened runtime, which
    is what notarisation requires). An unsigned local build ignores this
    file, so it is safe to ship in the repository.
  -->
  <key>com.apple.security.device.camera</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- WKWebView runs its content in a separate, JIT-enabled process. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>
